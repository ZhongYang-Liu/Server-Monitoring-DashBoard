
body{
    background:#111827;
    color:white;
    font-family:Arial,sans-serif;
    margin:0;
}

h1{
    text-align:center;
    padding:30px;
}

.container{
    display:flex;
    justify-content:center;
    gap:30px;
    flex-wrap:wrap;
}

.card{
    width:220px;
    background:#1f2937;
    border-radius:15px;
    padding:25px;
    box-shadow:0 10px 20px rgba(0,0,0,.35);
    transition:.3s;
}

.value{
    font-size:42px;
    font-weight:bold;
}

.chart-container{
    width:90%;
    margin:40px auto;
    background:#1f2937;
    padding:25px;
    border-radius:15px;
}

.normal{
    border:3px solid #22c55e;
}

.warning{
    border:3px solid #facc15;
}

.danger{
    border:3px solid #ef4444;
}

.warning-message{
    color:#ef4444;
    font-size:22px;
    margin:20px;
    font-weight:bold;
}
